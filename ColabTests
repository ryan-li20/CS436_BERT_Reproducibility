# ============================================================
# MODEL 1: GOOGLE TRANSLATE (via deep-translator)
# ============================================================
def translate_google(texts: List[str], src='en', tgt='de') -> List[str]:
    """Translate using Google Translate"""
    print(f"[Model 1/3] Translating with Google Translate...")
    translator = GoogleTranslator(source=src, target=tgt)
    translations = []
    
    for text in tqdm(texts, desc="Google Translate"):
        try:
            translation = translator.translate(text)
            translations.append(translation)
        except Exception as e:
            print(f"  Warning: Translation error, using source text")
            translations.append(text)
    
    return translations

# ============================================================
# MODEL 2: MARIAN MT (Helsinki-NLP)
# ============================================================
def translate_marian(texts: List[str], 
                     model_name='Helsinki-NLP/opus-mt-en-de',
                     batch_size=8,
                     max_length=512) -> List[str]:
    """Translate using Marian MT model"""
    print(f"[Model 2/3] Loading Marian MT: {model_name}")
    
    # Load model and tokenizer
    tokenizer = MarianTokenizer.from_pretrained(model_name)
    model = MarianMTModel.from_pretrained(model_name)
    model = model.to(device)
    model.eval()
    
    print(f"  Device: {device}")
    print(f"  Translating...")
    
    translations = []
    
    with torch.no_grad():
        for i in tqdm(range(0, len(texts), batch_size), desc="Marian MT"):
            batch = texts[i:i+batch_size]
            
            # Tokenize
            inputs = tokenizer(
                batch, 
                return_tensors="pt", 
                padding=True, 
                truncation=True, 
                max_length=max_length
            )
            inputs = {k: v.to(device) for k, v in inputs.items()}
            
            # Generate
            outputs = model.generate(
                **inputs, 
                max_length=max_length,
                num_beams=4,
                early_stopping=True,
                do_sample=False
            )
            
            # Decode
            batch_translations = tokenizer.batch_decode(outputs, skip_special_tokens=True)
            translations.extend(batch_translations)
    
    # Clean up
    del model
    torch.cuda.empty_cache() if torch.cuda.is_available() else None
    
    return translations

# ============================================================
# MODEL 3: M2M100 (Facebook's Multilingual Model)
# ============================================================
def translate_m2m100(texts: List[str],
                     model_name='facebook/m2m100_418M',
                     src_lang='en',
                     tgt_lang='de',
                     batch_size=4,
                     max_length=512) -> List[str]:
    """Translate using M2M100 model"""
    print(f"[Model 3/3] Loading M2M100: {model_name}")
    
    # Load model and tokenizer
    tokenizer = M2M100Tokenizer.from_pretrained(model_name)
    model = M2M100ForConditionalGeneration.from_pretrained(model_name)
    model = model.to(device)
    model.eval()
    
    # Set source and target languages
    tokenizer.src_lang = src_lang
    
    print(f"  Device: {device}")
    print(f"  Translating...")
    
    translations = []
    
    with torch.no_grad():
        for i in tqdm(range(0, len(texts), batch_size), desc="M2M100"):
            batch = texts[i:i+batch_size]
            
            # Tokenize
            inputs = tokenizer(
                batch,
                return_tensors="pt",
                padding=True,
                truncation=True,
                max_length=max_length
            )
            inputs = {k: v.to(device) for k, v in inputs.items()}
            
            # Generate
            generated = model.generate(
                **inputs,
                forced_bos_token_id=tokenizer.get_lang_id(tgt_lang),
                max_length=max_length,
                num_beams=4,
                early_stopping=True,
                do_sample=False
            )
            
            # Decode
            batch_translations = tokenizer.batch_decode(generated, skip_special_tokens=True)
            translations.extend(batch_translations)
    
    # Clean up
    del model
    torch.cuda.empty_cache() if torch.cuda.is_available() else None
    
    return translations

