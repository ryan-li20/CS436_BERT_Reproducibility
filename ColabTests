# EVALUATE WITH BERTSCORE
# ============================================================
def evaluate_with_bertscore(references: List[str], 
                           candidates: List[str],
                           lang: str = "de",
                           model_type: str = "bert-base-multilingual-cased",
                           num_layers: int = 9) -> Dict:
    """Evaluate using BERTScore"""
    print(f"Computing BERTScore...")
    print(f"  Model: {model_type}")
    print(f"  Layers: {num_layers}")
    print(f"  Device: {device}")
    
    P, R, F1 = bert_score(
        candidates, 
        references,
        lang=lang,
        model_type=model_type,
        num_layers=num_layers,
        verbose=False,
        device=device.type,
        batch_size=8,
        rescale_with_baseline=False
    )
    
    return {
        "precision": P.mean().item(),
        "recall": R.mean().item(),
        "f1": F1.mean().item(),
        "precision_std": P.std().item(),
        "recall_std": R.std().item(),
        "f1_std": F1.std().item(),
        "all_f1_scores": F1.tolist()
    }

# ============================================================
# EVALUATE WITH BLEU
# ============================================================
def evaluate_with_bleu(references: List[str], candidates: List[str]) -> Dict:
    """Evaluate using BLEU score"""
    print(f"Computing BLEU...")
    
    refs = [[ref] for ref in references]
    bleu = sacrebleu.corpus_bleu(candidates, list(zip(*refs)))
    
    return {
        "bleu": bleu.score,
        "bleu_precisions": bleu.precisions
    }

