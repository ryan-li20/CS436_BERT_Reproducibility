# ============================================================
# PREPROCESSING FUNCTION (STANDARDIZED)
# ============================================================
#Spacy
try:
    nlp = spacy.load("en_core_web_sm")
except:
    print("Warning: spaCy model not found. Install with: python -m spacy download en_core_web_sm")
    nlp = None
    
def preprocess_text(text: str, max_length: int = 512) -> str:
    """
    Wrapper
    """
    #text = text.strip()
    #if len(text) > max_length * 4:  # Rough char estimate for tokens
        #text = text[:max_length * 4]
    return preprocess_with_bpe(text, max_length)

def preprocess_text_none(text: str, max_length: int = 512) -> str:
    """
    No processing
    """
    return text

def preprocess_text_standard(text: str, max_length: int = 512) -> str:
    """
    Standardized preprocessing for all models
    - Strip whitespace
    - Truncate to max_length characters (approximate)
    """
    text = text.strip()
    if len(text) > max_length * 4:  # Rough char estimate for tokens
      text = text[:max_length * 4]
    return text

def preprocess_spacy(text: str, max_length: int = 512) -> str:
    """
    Tokenize text using spaCy, then rejoin tokens
    - Uses spaCy's linguistic tokenization
    - Preserves token boundaries with spaces
    """
    if nlp is None:
        raise RuntimeError("spaCy model not loaded")
    
    text = text.strip()
    if len(text) > max_length * 4:
        text = text[:max_length * 4]
    
    doc = nlp(text)
    tokens = [token.text for token in doc]
    
    # Rejoin tokens with spaces
    return " ".join(tokens)

def preprocess_with_nltk(text: str, max_length: int = 512) -> str:
    """
    Tokenize text using NLTK, then rejoin tokens
    - Uses NLTK's word_tokenize
    - Preserves token boundaries with spaces
    """
    text = text.strip()
    if len(text) > max_length * 4:
        text = text[:max_length * 4]
    
    tokens = word_tokenize(text)
    
    # Rejoin tokens with spaces
    return " ".join(tokens)

def preprocess_with_bpe(text: str, max_length: int = 512, vocab_size: int = 1000) -> str:
    """
    Apply Byte-Pair Encoding (BPE) tokenization
    - Trains a simple BPE tokenizer on the input text
    - Returns space-joined subword tokens
    
    Note: For production, you'd typically train BPE on a corpus once
    and reuse the trained tokenizer
    """
    text = text.strip()
    if len(text) > max_length * 4:
        text = text[:max_length * 4]
    
    # Initialize BPE tokenizer
    tokenizer = Tokenizer(BPE(unk_token="[UNK]"))
    tokenizer.pre_tokenizer = Whitespace()
    
    # Train on the input text (in production, train once on a corpus)
    trainer = BpeTrainer(vocab_size=vocab_size, special_tokens=["[UNK]"])
    tokenizer.train_from_iterator([text], trainer=trainer)
    
    # Encode and get tokens
    output = tokenizer.encode(text)
    tokens = output.tokens
    
    # Return space-joined tokens
    return " ".join(tokens)

